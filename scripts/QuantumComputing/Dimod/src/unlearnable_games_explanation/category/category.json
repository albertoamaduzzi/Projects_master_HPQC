  "math": {
    "name": "SKGameMath",
    "objects": [
      {
        "name": "Params",
        "symbol": "(N,α,β,ε,J0,Jd)",
        "space": "parameter space",
        "paper_ref": "Sec. II",
        "impl": "model.GameParams"
      },
      {
        "name": "Ensemble",
        "symbol": "(υ,η)",
        "space": "moments of the J law",
        "paper_ref": "Eqs. 9-10",
        "impl": "model.upsilon / model.eta"
      },
      {
        "name": "J",
        "symbol": "J_ij",
        "space": "R^{N×N}",
        "paper_ref": "Eqs. 8, 11",
        "impl": "model.InteractionEnsemble.sample"
      },
      {
        "name": "Q",
        "symbol": "Q_i(t)",
        "space": "R^N",
        "paper_ref": "Eq. 3",
        "impl": "model.SKGame.Q"
      },
      {
        "name": "m",
        "symbol": "m_i(t)",
        "space": "[-1,1]^N",
        "paper_ref": "Eq. 2",
        "impl": "model.SKGame.intentions"
      },
      {
        "name": "S",
        "symbol": "S_i(t)",
        "space": "{-1,1}^N",
        "paper_ref": "Eq. 1",
        "impl": "model.SKGame.decisions"
      },
      {
        "name": "Rvec",
        "symbol": "R_i(t)",
        "space": "R^N",
        "paper_ref": "Eq. 4",
        "impl": "model.SKGame.rewards"
      },
      {
        "name": "Trajectory",
        "symbol": "{Q,m,S}_{t}",
        "space": "(R^N)^T",
        "paper_ref": "Eqs. 5, 14",
        "impl": "model.SKGame.run + recorders"
      },
      {
        "name": "RN",
        "symbol": "R_N",
        "space": "R",
        "paper_ref": "Eq. 12",
        "impl": "observables.average_reward"
      },
      {
        "name": "e",
        "symbol": "e_i = S*_i R*_i",
        "space": "R^N",
        "paper_ref": "Eq. 16",
        "impl": "observables.individual_rewards"
      },
      {
        "name": "Corr",
        "symbol": "C(t,t+τ), C(τ)",
        "space": "R^{T×T}",
        "paper_ref": "Eq. 15",
        "impl": "observables.stationary_autocorr"
      },
      {
        "name": "q",
        "symbol": "q = C(t,t)",
        "space": "[0,1]",
        "paper_ref": "Sec. IV",
        "impl": "observables.q_param"
      },
      {
        "name": "M",
        "symbol": "M(t)",
        "space": "[-1,1]",
        "paper_ref": "Eq. 11",
        "impl": "observables.magnetisation"
      },
      {
        "name": "Overlap",
        "symbol": "C×_N",
